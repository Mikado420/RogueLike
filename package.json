{
  "name": "endless-garden",
  "version": "0.1.0",
  "description": "エンドレスガーデン — 見下ろしアイソメのアクションハクスラMMO",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p server --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit",
    "balance": "vite-node scripts/balance.ts",
    "dev:server": "wrangler dev --config server/wrangler.jsonc --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config server/wrangler.jsonc",
    "loadtest": "vite-node scripts/loadtest.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5",
    "wrangler": "^4.157.0"
  }
}
